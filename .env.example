# AI assistant backend (bun run server). Set at least one provider key.
# Pick the active provider with AI_PROVIDER=openrouter|groq|gemini|custom (defaults to the first one with a key).
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional model overrides, e.g. OPENROUTER_MODEL=..., GROQ_MODEL=..., GEMINI_MODEL=...
# Custom provider: any OpenAI-compatible endpoint with tool calling
CUSTOM_AI_BASE_URL=
CUSTOM_AI_API_KEY=
CUSTOM_AI_MODEL=
CUSTOM_AI_LABEL=
