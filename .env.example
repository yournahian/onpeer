# ============================================================
# OnPeer — environment variables reference
# Copy to .env and fill in values for local Vite dev (VITE_* only).
# Worker secrets go in .dev.vars (local wrangler dev) or Cloudflare Secrets (production).
# NEVER commit real secrets to source control.
# ============================================================

# ---- Public Vite vars (safe to expose in the browser) ----
VITE_P2P_ESCROW_ADDRESS=0xf719ebbc5080aee09e38909764b897e0bf01a9b0
VITE_P2P_DEPLOY_BLOCK=72902228
# Optional: EURC token address on Arc Testnet (swap page)
VITE_ARC_TESTNET_EURC_ADDRESS=

# ---- Cloudflare Worker secrets (.dev.vars for local, `wrangler secret put` for production) ----

# Session signing key — 64+ random hex chars (openssl rand -hex 32)
SESSION_SECRET=

# AES-256-GCM vault master key — exactly 64 hex chars (openssl rand -hex 32)
VAULT_MASTER_KEY=

# Didit identity verification
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=   # copy from Didit Business Console -> Developers -> Webhooks (never log)
# DIDIT_MODE=sandbox    # set to 'sandbox' for testnet/sandbox (set 'live' in wrangler.jsonc vars for production)

# Verifier relayer private key — MUST be a separate wallet, NOT owner/arbiter/backupArbiter
VERIFIER_PRIVATE_KEY=0x...

# Email notifications (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM="OnPeer <noreply@onpeer.xyz>"

# Public app URL (used to build links in emails; defaults to https://app.onpeer.xyz)
# PUBLIC_APP_URL=https://app.onpeer.xyz

# ---- AI assistant provider keys (Worker secrets via `wrangler secret put` or `.dev.vars` — NEVER commit in wrangler.jsonc) ----
# Pick the active provider with AI_PROVIDER=openrouter|groq|gemini|custom
# (defaults to the first one that has a key)
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional model overrides
# OPENROUTER_MODEL=openai/gpt-4o-mini
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.5-flash
# Custom OpenAI-compatible endpoint with tool calling:
CUSTOM_AI_BASE_URL=
CUSTOM_AI_API_KEY=
CUSTOM_AI_MODEL=
CUSTOM_AI_LABEL=

# ---- Legacy / local-only (server/ Bun process — no longer used in production) ----
# AGENT_PORT=3001         # port for the legacy Bun assistant server (default 3001)
# RPC_PROXY_BASE_URL=     # Arc Studio-provisioned RPC proxy (optional)
# RPC_PROXY_TOKEN=
# RPC_PROXY_CHAINS=
