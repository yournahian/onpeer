# ============================================================
# OnPeer — environment variables reference
# Copy to .env and fill in values for local Vite dev (VITE_* only).
# Worker secrets go in .dev.vars (local wrangler dev) or Cloudflare Secrets (production).
# NEVER commit real secrets to source control.
# ============================================================

# ---- Public Vite vars (safe to expose in the browser) ----
VITE_P2P_ESCROW_ADDRESS=0x7f661625bC08d72E156A206ee8D24022D7463350
VITE_P2P_DEPLOY_BLOCK=74250625
VITE_P2P_EURC_ESCROW_ADDRESS=0x26Ef2B69AC928457E348BeEd72Bf116dB81438B9
VITE_P2P_EURC_DEPLOY_BLOCK=74250630
# Optional: EURC token address on Arc Testnet (swap page)
VITE_ARC_TESTNET_EURC_ADDRESS=
# Circle Onramp Sandbox widget origin (used only on /buy; Swap & Bridge work without it)
VITE_ONRAMP_WIDGET_BASE_URL=https://onramp-sandbox.arc.io
# Optional WalletConnect v2 Project ID (https://cloud.reown.com) — enables mobile deep-link wallets inside Telegram Mini App
VITE_WALLETCONNECT_PROJECT_ID=

# ---- Telegram Mini App & Live Order Notification Bot ----
# Public bot handle without '@' (e.g. onpeer_bot) — set in wrangler.jsonc vars or Cloudflare Variables
# TELEGRAM_BOT_USERNAME=onpeer_bot
# Bot token from @BotFather (`wrangler secret put TELEGRAM_BOT_TOKEN`)
TELEGRAM_BOT_TOKEN=
# Random 32-64 char webhook secret (`openssl rand -hex 24`, set via `wrangler secret put TELEGRAM_WEBHOOK_SECRET`)
TELEGRAM_WEBHOOK_SECRET=
# Optional: Telegram chat ID for arbiter dispute alerts fallback
# TELEGRAM_ADMIN_CHAT_ID=

# ---- Cloudflare Worker secrets (.dev.vars for local, `wrangler secret put` for production) ----

# Local dev Postgres connection string (MUST point to a separate dev database, NEVER production)
# CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgres://onpeer_worker:PASSWORD@DEV_HOST:5432/postgres?sslmode=require

# Session signing key — 64+ random hex chars (openssl rand -hex 32)
SESSION_SECRET=

# AES-256-GCM vault master key — exactly 64 hex chars (openssl rand -hex 32)
VAULT_MASTER_KEY=

# Didit identity verification
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=   # copy from Didit Business Console -> Developers -> Webhooks (never log)
# DIDIT_MODE=sandbox    # set to 'sandbox' for testnet/sandbox (set 'live' in wrangler.jsonc vars for production)

# Verifier relayer private key — MUST be a separate wallet, NOT owner/arbiter/backupArbiter
VERIFIER_PRIVATE_KEY=0x...

# Email notifications (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM="OnPeer <noreply@onpeer.xyz>"
# Fallback inbox for arbiter dispute alerts when the arbiter wallet has no verified P2P account email
ADMIN_ALERT_EMAIL=

# Public app URL (used to build links in emails; defaults to https://app.onpeer.xyz)
# PUBLIC_APP_URL=https://app.onpeer.xyz

# ---- Phase 3 Circle Onramp (SANDBOX ONLY — never put real/live keys here) ----
# Obtain a Testnet Onramp API key (`TEST_API_KEY:...`) in Circle Console -> App Kits -> Onramp Kit
CIRCLE_API_KEY=
ONRAMP_API_BASE_URL=https://api-test.circle.com
ONRAMP_WIDGET_BASE_URL=https://onramp-sandbox.arc.io
# Bare hostname only (no scheme/path/port); set in wrangler.jsonc as app.onpeer.xyz (or localhost for local iframe testing)
ONRAMP_REFERRER_DOMAIN=app.onpeer.xyz

# ---- AI assistant provider keys (Worker secrets via `wrangler secret put` or `.dev.vars` — NEVER commit in wrangler.jsonc) ----
# Pick the active provider with AI_PROVIDER=openrouter|groq|gemini|custom
# (defaults to the first one that has a key)
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional model overrides
# OPENROUTER_MODEL=openai/gpt-4o-mini
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.5-flash
# Custom OpenAI-compatible endpoint with tool calling:
CUSTOM_AI_BASE_URL=
CUSTOM_AI_API_KEY=
CUSTOM_AI_MODEL=
CUSTOM_AI_LABEL=

# ---- Legacy / local-only (server/ Bun process — no longer used in production) ----
# AGENT_PORT=3001         # port for the legacy Bun assistant server (default 3001)
# RPC_PROXY_BASE_URL=     # Arc Studio-provisioned RPC proxy (optional)
# RPC_PROXY_TOKEN=
# RPC_PROXY_CHAINS=
