{
  "name": "onpeer",
  "main": "worker/index.ts",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ARC_NETWORK": "mainnet",
    "VITE_ARC_NETWORK": "mainnet",
    "VITE_P2P_ESCROW_ADDRESS": "0xC073b1A5ac4004fD82cAc6BDA5548FFc5E5cB97e",
    "VITE_P2P_DEPLOY_BLOCK": "33297066",
    "VITE_P2P_EURC_ESCROW_ADDRESS": "0xd0dca77625992d3851748B365Ace63803c5d1759",
    "VITE_P2P_EURC_DEPLOY_BLOCK": "33297066",
    "VITE_P2P_CIRBTC_ESCROW_ADDRESS": "0x6ba3b81833b6354f08483740211af3ddda396b39",
    "VITE_P2P_CIRBTC_DEPLOY_BLOCK": "73734225",
    "VITE_P2P_WETH_ESCROW_ADDRESS": "0xbd79693411ee47e2acbba14e9353e7e0c43bf6f3",
    "VITE_P2P_WETH_DEPLOY_BLOCK": "73734238",
    "VITE_ARC_MAINNET_EURC_ADDRESS": "0xbEf5f6d51CB62b58e6A8f77868681825C6fe21c1",
    "VITE_ARC_TESTNET_EURC_ADDRESS": "0x89B50855Aa3bE2F677cD6303Cec089B5F319D72a",
    "DIDIT_MODE": "live",
    "ACHSWAP_FEE_BPS": "5",
    "ACHSWAP_FEE_RECIPIENT": "0x81eA9AdE2805e310E9f884a75B3a24Ab74557C69",
    "PUBLIC_APP_URL": "https://app.onpeer.xyz",
    "ONRAMP_API_BASE_URL": "https://api-test.circle.com",
    "ONRAMP_WIDGET_BASE_URL": "https://onramp-sandbox.arc.io",
    "VITE_ONRAMP_WIDGET_BASE_URL": "https://onramp-sandbox.arc.io",
    "ONRAMP_REFERRER_DOMAIN": "app.onpeer.xyz"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "29784572f5b142fbaec583da0f7d131f"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "AI_SETTINGS_KV",
      "id": "87e9c110ebe247f784a9db6e83858216"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/brand/*",
      "!/flags/*",
      "!/hero/*",
      "!/logos/*",
      "!/favicon.ico",
      "!/theme-init.js"
    ]
  }
}
